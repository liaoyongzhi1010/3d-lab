\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Success case (outdoor patio, up to $+10.4$~dB). Rows: GT, Gen3R baseline, ours, disocclusion mask, error map of baseline, error map of ours; columns are target views. Error concentrates (brighter) in the disoccluded strip for the baseline and is reduced by injection, while visible content is unchanged.}}{7}{figure.caption.18}\protected@file@percent }
\newlabel{fig:panel_success}{{2}{7}{Success case (outdoor patio, up to $+10.4$~dB). Rows: GT, Gen3R baseline, ours, disocclusion mask, error map of baseline, error map of ours; columns are target views. Error concentrates (brighter) in the disoccluded strip for the baseline and is reduced by injection, while visible content is unchanged}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Failure case ($-8.5$~dB). The Gen3R baseline already reconstructs the disoccluded region well, so forcing feed-forward evidence increases error. The reliability gate rejects injection here, falling back to the baseline.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:panel_failure}{{3}{8}{Failure case ($-8.5$~dB). The Gen3R baseline already reconstructs the disoccluded region well, so forcing feed-forward evidence increases error. The reliability gate rejects injection here, falling back to the baseline}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Teaser: input, GT, Gen3R baseline, and ours across target views, with per-target disocclusion-PSNR gains.}}{9}{figure.caption.20}\protected@file@percent }
