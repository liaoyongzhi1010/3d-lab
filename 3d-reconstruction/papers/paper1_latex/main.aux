\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Standard full-image metrics (759 frames, 21 scenes with disocclusion). LPIPS uses the VGG backbone, matching Flash3D and pixelSplat. Our selective injection achieves the best perceptual quality (LPIPS) while lifting PSNR $+1.45$~dB over the generative baseline.}}{4}{table.caption.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Published methods for positioning only (different protocols, not a head-to-head comparison). Our generative backbone optimizes plausibility not pixel-MSE, and we evaluate long 49-frame sequences on disocclusion-heavy frames.}}{4}{table.caption.15}\protected@file@percent }
