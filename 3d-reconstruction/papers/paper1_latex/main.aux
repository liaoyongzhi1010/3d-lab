\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mechanism: the invisible-region gap between the geometry expert and the generative baseline predicts injection benefit ($r=0.982$, N=166).}}{9}{figure.caption.21}\protected@file@percent }
\newlabel{fig:mechanism}{{5}{9}{Mechanism: the invisible-region gap between the geometry expert and the generative baseline predicts injection benefit ($r=0.982$, N=166)}{figure.caption.21}{}}
